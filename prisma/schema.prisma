// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Room {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  players    String[] @default([])
  createdBy  String
  maxPlayers Int
  status     String
  createdAt  DateTime @default(now())
}

model Game {
  id               String       @id @default(auto()) @map("_id") @db.ObjectId
  associatedRoomId String       @unique
  players          Player[]
  currentTurn      String
  gameLog          GameLogMsg[]
  boardState       gameState[]
  currentAction    String       
}

type Player {
  username             String
  color                String
  position             Int
  balance              Int
  properties           Int[]
  ownedPropertiesGroup Int[]
  jailed               Boolean
  turnsInJail          Int
}

type gameState {
  tiles  Tile[]
  groups Groups[]
}

type Tile {
  id         Int
  type       String
  spriteName String
  position   Int
  owner      String?
  houses     Int?
  price      Int?
  rent       Int?
  mortgaged  Boolean?
  name       String
}

type Groups {
  groupId    Int
  color      String
  properties Int[]
}

type GameLogMsg {
  username String
  msg      String
}


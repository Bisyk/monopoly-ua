// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Room {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  players    String[] @default([])
  createdBy  String
  maxPlayers Int
  status     String
  createdAt  DateTime @default(now())
}

model Game {
  id                        String       @id @default(auto()) @map("_id") @db.ObjectId
  associatedRoomId          String       @unique
  status                    String       @default("STARTED")
  winnerUsername            String?
  eliminatedPlayers         String[]     @default([])
  players                   Player[]
  currentTurn               String
  gameLog                   GameLogMsg[]
  board                     BoardState
  currentAction             String
  auctionParticipants       String[]
  activeAuctionBidder String?
  auctionBidAmount         Int?
  auctionedTileId           Int?
  activeChance              Chance
  activeTrade               Trade
}

type Player {
  username             String
  color                String
  position             Int
  balance              Int
  properties           Int[]
  ownedPropertyGroupIds Int[]
  jailed               Boolean
  turnsInJail          Int
  doublesInRow         Int
  bonusRoll            Boolean
}

type BoardState {
  tiles  Tile[]
  groups Groups[]
}

type Tile {
  id            Int
  groupId       Int?
  assetId    String
  name          String
  price         Int?
  type          String
  owner         String?
  houses        Int?
  mortgaged     Boolean?
  position      Int
  rentLevel     Int?
  rentLevels    Int[]    @default([])
  mortgagePrice Int?
  buybackPrice  Int?
  taxAmount     Int?
}

type Groups {
  groupId            Int
  color              String
  properties         Int[]
  upgradePrice       Int?
  isFullSet          Boolean @default(false)
  isUpgradeAvailable Boolean @default(true)
}

type GameLogMsg {
  username String
  msg      String
}

type Chance {
  type   String
  amount Int?
  text   String?
}

type Trade {
  from          String?
  to            String?
  given         Int[]
  received      Int[]
  givenMoney    Int?
  receivedMoney Int?
}
